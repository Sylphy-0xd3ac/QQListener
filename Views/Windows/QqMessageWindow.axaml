<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QQListener.Views.Windows"
        x:Class="QQListener.Views.Windows.QqMessageWindow"
        x:DataType="local:QqMessageWindow"
        SizeToContent="WidthAndHeight"
        CanResize="False" ShowInTaskbar="False" ShowActivated="False"
        SystemDecorations="None" Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Transparent"
        TransparencyBackgroundFallback="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
        Topmost="True">
    <!-- Window height follows the viewport: native blur never extends above the island. -->
    <Panel x:Name="DrawerViewport" ClipToBounds="True">
        <Border x:Name="Card" CornerRadius="12" MinWidth="300" MaxWidth="520"
                HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True">
            <Panel>
                <Border x:Name="SurfaceBackdrop" CornerRadius="12"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" Opacity="0.5" />
                <Border x:Name="SurfaceFrame" Padding="18,14" CornerRadius="12"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ContentControl x:Name="MessageContentHost" />
                        </ScrollViewer>
                        <ContentControl x:Name="ReplyBarHost" IsVisible="False" />
                        <TextBlock x:Name="QueuedMessagesText" IsVisible="False" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Panel>
        </Border>
    </Panel>
</Window>
