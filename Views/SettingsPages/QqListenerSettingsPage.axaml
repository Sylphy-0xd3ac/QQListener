<ci:SettingsPageBase x:Class="QQListener.Views.SettingsPages.QqListenerSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="600">

    <ci:SettingsPageBase.Styles>
        <Style Selector="WrapPanel > Control">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </ci:SettingsPageBase.Styles>

    <!-- 图标码位来自 ClassIsland 内置的 FluentSystemIcons-Resizable 字体
         （ic_fluent_*_20_regular）。这套字体跟 Segoe MDL2 的码位完全不是一回事，
         照着 MDL2 的表抄会得到一堆毫不相干的图形。 -->
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Spacing="4">

            <!-- 当前引擎运行状态；SnowLuma 独立安装，PMHQ 为内置实验选项。 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,4,0,0">
                内核
            </TextBlock>

            <Border CornerRadius="4" ClipToBounds="True" Margin="0,4,0,4">
                <controls:SettingsExpanderItem>
                    <Grid Margin="8" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                        <ci:FluentIcon Grid.Column="0"
                                       Glyph="&#xE653;"
                                       FontSize="40"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding KernelSetup.RuntimeStateBrush}" />

                        <StackPanel Grid.Column="1"
                                    Margin="16,0,12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="{Binding KernelSetup.RuntimeStateHeadline}" />
                            <TextBlock FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding KernelSetup.RuntimeStateText}" />
                            <TextBlock FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding KernelSetup.KernelVersionLine}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="16,12,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Command="{Binding KernelSetup.TogglePauseCommand}"
                                    IsEnabled="{Binding KernelSetup.IsSupported}"
                                    Content="{Binding KernelSetup.PauseButtonText}" />
                        </StackPanel>
                    </Grid>
                </controls:SettingsExpanderItem>
            </Border>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xEDCD;}"
                                       Header="高级设置"
                                       Description="积压上限、重新触发安装向导与卸载内核。">
                <controls:SettingsExpander.Items>
                    <controls:SettingsExpanderItem Content="重新触发安装向导"
                        Description="安装、更新 SnowLuma 并阅读其许可。PMHQ 已内置，请在底部调试区配置。">
                        <controls:SettingsExpanderItem.Footer>
                            <Button Content="重新触发安装向导" Click="OnOpenKernelWizardClick"
                                    IsEnabled="{Binding KernelSetup.IsSupported}" />
                        </controls:SettingsExpanderItem.Footer>
                    </controls:SettingsExpanderItem>

                    <controls:SettingsExpanderItem
                        IconSource="{ci:FluentIconSource Glyph=&#xE9AA;}"
                        Content="暂停时最多攒多少条"
                        Description="暂停期间的消息先攒着，恢复时一次性补弹。超过这个数就丢掉最旧的一条。1~500">
                        <controls:SettingsExpanderItem.Footer>
                            <NumericUpDown Value="{Binding Settings.PendingQueueLimit, Mode=TwoWay}"
                                           Minimum="1" Maximum="500" FormatString="0" Width="140" />
                        </controls:SettingsExpanderItem.Footer>
                    </controls:SettingsExpanderItem>

                    <controls:SettingsExpanderItem
                        IconSource="{ci:FluentIconSource Glyph=&#xEDCF;}"
                        Content="卸载内核"
                        Description="把钩子从 QQ 进程里摘掉，之后要重新注入才能继续收消息。先勾选确认才能点。">
                        <controls:SettingsExpanderItem.Footer>
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Content="我知道后果" IsChecked="{Binding KernelSetup.ConfirmUnload}" />
                                <Button Content="卸载" Command="{Binding KernelSetup.UnloadCoreCommand}" />
                            </WrapPanel>
                        </controls:SettingsExpanderItem.Footer>
                    </controls:SettingsExpanderItem>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- 监听 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,20,0,0">
                监听
            </TextBlock>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE02B;}"
                                       Header="启用监听"
                                       Description="控制是否向 ClassIsland 转发提醒。需要保留暂停期间的消息时，请使用上方“暂停监听”。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsEnabled, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="排除自己发送的消息"
                Description="默认开启。按协议里的发送者 QQ 号与当前账号判断，过滤自己发送的群聊、私聊消息及其同步回显。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ExcludeSelfMessages, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="确定时回复消息"
                Description="默认关闭：“确定”只收起提醒。开启后可引用群消息回复文本，或添加 OK 表情回应；私聊文本回复不带引用，表情回应仅支持群聊。“取消”始终不回复，并中断提醒。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ReplyOnConfirmEnabled, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
                <controls:SettingsExpander.Items>
                    <controls:SettingsExpanderItem>
                        <CheckBox Content="使用 OK 表情回应（仅群聊，不发送文本）"
                                  IsChecked="{Binding Settings.ReplyWithOkReaction, Mode=TwoWay}"
                                  IsEnabled="{Binding Settings.ReplyOnConfirmEnabled}" />
                    </controls:SettingsExpanderItem>
                    <controls:SettingsExpanderItem>
                        <TextBox Text="{Binding Settings.DefaultReplyText, Mode=TwoWay}" Watermark="收到"
                                 IsEnabled="{Binding Settings.ReplyOnConfirmEnabled}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                 HorizontalAlignment="Stretch" />
                    </controls:SettingsExpanderItem>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xEB78;}"
                                       Header="被 @ 时算重要消息"
                                       Description="按协议里的 @ 片段是否指向你的 QQ 号判断，不是去正文里搜「@」这个字，所以别人打字提到你不会误触发。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.SomeoneAtMe, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xEB74;}"
                                       Header="呼叫关键词"
                                       Description="消息里出现这个词时按最高等级提醒：单独的显示时长、默认置顶。开启上课暂停时会一同积压。">
                <controls:SettingsExpander.Footer>
                    <WrapPanel Orientation="Horizontal">
                        <TextBox Text="{Binding Settings.CallingKeyword, Mode=TwoWay}"
                                 Width="160"
                                 IsEnabled="{Binding Settings.CallingEnabled}" />
                        <ToggleSwitch IsChecked="{Binding Settings.CallingEnabled, Mode=TwoWay}" />
                    </WrapPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xEC30;}"
                                       Header="附件下载目录"
                                       Description="图片自动加载预览；文件可按下方开关自动下载，也可手动点击下载。默认保存到桌面，已有自定义目录保持不变。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding Settings.DownloadsDirectory, Mode=TwoWay}" Width="300" />
                        <Button Content="选择目录" Click="OnChooseDownloadsDirectoryClick" />
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="自动下载文件"
                                       Description="默认关闭。开启后在显示提醒时下载文件；已开始的文件下载不因提醒关闭而中断，不会自动打开或执行。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AutoDownloadFiles, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="声音"
                                       Description="提示音沿用 QQL 原版，普通消息与重要／呼叫消息使用不同音效。默认只开启 TTS，可分别切换。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox Content="提示音" IsChecked="{Binding Settings.NotificationSoundEnabled, Mode=TwoWay}" />
                        <CheckBox Content="TTS" IsChecked="{Binding Settings.SpeechEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <!-- 消息规则 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,20,0,0">
                消息规则
            </TextBlock>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xEA82;}"
                                       Header="上课时暂停提醒"
                                       Description="上课期间继续收消息并积压在内存中，下课后合并显示。重要人物和呼叫消息也会等待。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.DisableDuringClass, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="下课后延迟提醒（秒）"
                Description="给老师拖堂留出时间。延迟期间的新消息也会积压；再次上课会重新等待。0 表示不延迟，最多 3600 秒。">
                <controls:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.AfterClassDelaySeconds, Mode=TwoWay}"
                                   Minimum="0" Maximum="3600" Increment="10" FormatString="0" Width="140"
                                   IsEnabled="{Binding Settings.DisableDuringClass}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xEE0F;}"
                                       Header="关键词黑名单"
                                       Description="一行一条。发送人、群名或正文里出现任意一条，这条消息直接丢掉。比下面所有规则都优先。">
                <controls:SettingsExpander.Items>
                    <controls:SettingsExpanderItem>
                        <TextBox Text="{Binding Settings.BlacklistText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 HorizontalAlignment="Stretch"
                                 MinHeight="88"
                                 Watermark="广告&#x0a;红包" />
                    </controls:SettingsExpanderItem>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE3F2;}"
                                       Header="会话黑名单"
                                       Description="一行一条。整串相同的群号或 QQ 号，或者群名／昵称里的一段文字。命中的会话整个不提醒。">
                <controls:SettingsExpander.Items>
                    <controls:SettingsExpanderItem>
                        <TextBox Text="{Binding Settings.ConversationBlockListText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 HorizontalAlignment="Stretch"
                                 MinHeight="88"
                                 Watermark="123456789&#x0a;广告群" />
                    </controls:SettingsExpanderItem>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE426;}"
                                       Header="会话白名单"
                                       Description="留空 = 不限制。一旦写了内容，就只有名单里的群和联系人会提醒，格式跟会话黑名单一样。">
                <controls:SettingsExpander.Items>
                    <controls:SettingsExpanderItem>
                        <TextBox Text="{Binding Settings.ConversationAllowListText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 HorizontalAlignment="Stretch"
                                 MinHeight="88"
                                 Watermark="987654321&#x0a;高三(1)班" />
                    </controls:SettingsExpanderItem>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xED43;}"
                                       Header="重要人物"
                                       Description="一行一条：整串相同的 QQ 号，或备注／群名片／昵称里的一段文字。这些人发的消息升级为重要消息。">
                <controls:SettingsExpander.Items>
                    <controls:SettingsExpanderItem>
                        <TextBox Text="{Binding Settings.ImportantPersonsText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 HorizontalAlignment="Stretch"
                                 MinHeight="88"
                                 Watermark="10001&#x0a;班主任" />
                    </controls:SettingsExpanderItem>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xF05B;}"
                                       Header="重要关键词"
                                       Description="一行一条。发送人、群名或正文里出现任意一条，就升级为重要消息。">
                <controls:SettingsExpander.Items>
                    <controls:SettingsExpanderItem>
                        <TextBox Text="{Binding Settings.ImportantKeywordsText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 HorizontalAlignment="Stretch"
                                 MinHeight="88"
                                 Watermark="作业&#x0a;通知&#x0a;考试" />
                    </controls:SettingsExpanderItem>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE4C4;}"
                                       Header="只在这个时间段内提醒"
                                       Description="只保留指定时间段内收到的消息。关闭后不限制时间；上课暂停独立生效。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.RuleTimeWindowEnabled, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
                <controls:SettingsExpander.Items>
                    <controls:SettingsExpanderItem
                        IconSource="{ci:FluentIconSource Glyph=&#xE31C;}"
                        Content="时间段"
                        Description="24 小时制 HH:mm。结束早于开始表示跨过午夜（比如 22:00 至 07:00）；两个填一样表示不限制。">
                        <controls:SettingsExpanderItem.Footer>
                            <WrapPanel Orientation="Horizontal">
                                <TextBox Text="{Binding Settings.RuleTimeWindowStartText, Mode=TwoWay}"
                                         Width="80" />
                                <TextBlock Text="至" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Settings.RuleTimeWindowEndText, Mode=TwoWay}"
                                         Width="80" />
                            </WrapPanel>
                        </controls:SettingsExpanderItem.Footer>
                    </controls:SettingsExpanderItem>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- 提醒外观 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,20,0,0">
                提醒外观
            </TextBlock>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE84F;}"
                                       Header="性能模式"
                                       Description="关掉毛玻璃背板和出入场动画，换成纯色底 + 直接显示。低配机器上浮窗不再卡顿。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.PerformanceMode, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE127;}"
                                       Header="重复消息冷却（秒）"
                                       Description="内容完全相同的消息在这段时间内只提醒一次，用来挡住 QQ 的重复推送。1~3600">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.CooldownSeconds, Mode=TwoWay}"
                             Width="100"
                             HorizontalAlignment="Right" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xF361;}"
                                       Header="普通消息停留（秒）"
                                       Description="没命中任何规则的消息在屏幕上停多久。1~3600">
                <controls:SettingsExpander.Footer>
                    <WrapPanel Orientation="Horizontal">
                        <TextBox Text="{Binding Settings.NormalDurationSeconds, Mode=TwoWay}" Width="100" />
                        <ToggleSwitch IsChecked="{Binding Settings.NormalTopmost, Mode=TwoWay}"
                                      OnContent="顶栏置顶"
                                      OffContent="顶栏不置顶" />
                    </WrapPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE4C6;}"
                                       Header="重要消息停留（秒）"
                                       Description="命中重要人物、重要关键词，或被 @ 的消息。1~3600">
                <controls:SettingsExpander.Footer>
                    <WrapPanel Orientation="Horizontal">
                        <TextBox Text="{Binding Settings.ImportantDurationSeconds, Mode=TwoWay}" Width="100" />
                        <ToggleSwitch IsChecked="{Binding Settings.ImportantTopmost, Mode=TwoWay}"
                                      OnContent="顶栏置顶"
                                      OffContent="顶栏不置顶" />
                    </WrapPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE9A8;}"
                                       Header="呼叫消息停留（秒）"
                                       Description="命中呼叫关键词的消息。默认十分钟，好让你从别的事情里抬起头。1~86400">
                <controls:SettingsExpander.Footer>
                    <WrapPanel Orientation="Horizontal">
                        <TextBox Text="{Binding Settings.CallingDurationSeconds, Mode=TwoWay}" Width="100" />
                        <ToggleSwitch IsChecked="{Binding Settings.CallingTopmost, Mode=TwoWay}"
                                      OnContent="顶栏置顶"
                                      OffContent="顶栏不置顶" />
                    </WrapPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xF373;}"
                                       Header="长消息滚动速度"
                                       Description="一屏放不下的正文会自己滚动。拖到 0 就不滚，只显示开头。">
                <controls:SettingsExpander.Footer>
                    <WrapPanel Orientation="Horizontal">
                        <Slider Value="{Binding Settings.RollingSpeed, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="4"
                                TickFrequency="0.1"
                                Width="160"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Settings.RollingSpeed, StringFormat={}{0:F2}}"
                                   Width="40"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </WrapPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <!-- 调试 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,20,0,0">
                调试
            </TextBlock>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE1E9;}"
                                       Header="试一条假消息"
                                       Description="{Binding PreviewResultText}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnShowTestNotificationClick" Content="纯文字" />
                        <Button Click="OnShowTestImportantNotificationClick" Content="图片与附件" />
                        <Button Click="OnShowTestCallingNotificationClick" Content="引用回复" />
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="消息引擎"
                                       Description="{Binding EngineDescription}">
                <controls:SettingsExpander.Footer>
                    <ComboBox ItemsSource="{Binding EngineNames}"
                              SelectedIndex="{Binding SelectedEngineIndex, Mode=TwoWay}"
                              IsEnabled="{Binding KernelSetup.IsSupported}" MinWidth="200" />
                </controls:SettingsExpander.Footer>
                <controls:SettingsExpander.Items>
                    <controls:SettingsExpanderItem IsVisible="{Binding IsPmhqSelected}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="实验性功能：无需启动凭证，使用本机 QQ；真实 QQ 发包尚未验证。切换后请重启 QQ。"
                                       TextWrapping="Wrap" Foreground="#D29922" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="打开 PMHQ 内核目录" Click="OnOpenPmhqConfigurationClick" />
                                <Button Content="重新检查" Click="OnRecheckPmhqClick" />
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsExpanderItem>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE161;}"
                                       Header="手动操作"
                                       Description="立即取一次：不等消息自己来，马上把管道里已经到的取出来。重置去重：忘掉冷却记录，让刚被挡下的消息能再弹一次。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnPollNowClick" IsEnabled="{Binding CanPoll}" Content="立即取一次" />
                        <Button Click="OnResetClick" IsEnabled="{Binding ProviderAvailable}" Content="重置去重" />
                        <Button Click="OnReplayLatestClick" IsEnabled="{Binding CanReplay}" Content="重放最后一条" />
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xEE21;}"
                                       Header="监听状态"
                                       Description="{Binding Diagnostics.ListenerState}" />

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xEB26;}"
                                       Header="最近收下的一条"
                                       Description="{Binding Diagnostics.LastAcceptedSummary}" />

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE837;}"
                                       Header="最近挡掉的一条"
                                       Description="{Binding Diagnostics.LastIgnoredReason}" />

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xF27B;}"
                                       Header="解析情况"
                                       Description="{Binding Diagnostics.LastFormatSummary}" />

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE809;}"
                                       Header="最近一次报错"
                                       Description="{Binding Diagnostics.LastErrorSummary}" />

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE9E4;}"
                                       Header="文件位置"
                                       Description="{Binding Diagnostics.RuntimeSummary}"
                                       IsExpanded="False">
                <controls:SettingsExpander.Items>
                    <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource Glyph=&#xE875;}"
                                                   Content="插件目录">
                        <controls:SettingsExpanderItem.Footer>
                            <SelectableTextBlock Text="{Binding Diagnostics.PluginFolderPath}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 MaxWidth="380"
                                                 TextWrapping="Wrap" />
                        </controls:SettingsExpanderItem.Footer>
                    </controls:SettingsExpanderItem>

                    <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource Glyph=&#xE508;}"
                                                   Content="当前程序集">
                        <controls:SettingsExpanderItem.Footer>
                            <SelectableTextBlock Text="{Binding Diagnostics.AssemblyPath}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 MaxWidth="380"
                                                 TextWrapping="Wrap" />
                        </controls:SettingsExpanderItem.Footer>
                    </controls:SettingsExpanderItem>

                    <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource Glyph=&#xEF27;}"
                                                   Content="配置文件">
                        <controls:SettingsExpanderItem.Footer>
                            <SelectableTextBlock Text="{Binding Diagnostics.SettingsPath}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 MaxWidth="380"
                                                 TextWrapping="Wrap" />
                        </controls:SettingsExpanderItem.Footer>
                    </controls:SettingsExpanderItem>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- 关于 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,20,0,0">
                关于
            </TextBlock>

            <Border CornerRadius="4"
                    ClipToBounds="True"
                    Margin="0,4,0,4">
                <controls:SettingsExpanderItem>
                    <Grid Margin="12" ColumnDefinitions="Auto,*,Auto">
                        <ci:FluentIcon Glyph="&#xE02B;"
                                       Grid.Column="0"
                                       FontSize="40"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="QQListener  " FontSize="20" FontWeight="SemiBold" />
                                <Run Text="{Binding PluginInfo.VersionDisplay, Mode=OneWay}"
                                     FontSize="14"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding PluginInfo.CopyrightLine}" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding PluginInfo.LicenseLine}" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding PluginInfo.SdkLine}" />
                            <TextBlock FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding PluginInfo.Credits}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Top">
                            <Button Padding="8,5"
                                    BorderBrush="Transparent"
                                    Background="Transparent"
                                    ToolTip.Tip="GitHub 仓库"
                                    Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                                    CommandParameter="{Binding PluginInfo.Url}">
                                <ci:FluentIcon Glyph="&#xE508;" FontSize="18" />
                            </Button>
                            <Button Padding="8,5"
                                    BorderBrush="Transparent"
                                    Background="Transparent"
                                    ToolTip.Tip="常见问题 Q&amp;A"
                                    Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                                    CommandParameter="{Binding PluginInfo.QaUrl}">
                                <ci:FluentIcon Glyph="&#xE9E4;" FontSize="18" />
                            </Button>
                            <Button Padding="8,5"
                                    BorderBrush="Transparent"
                                    Background="Transparent"
                                    ToolTip.Tip="报告问题"
                                    Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                                    CommandParameter="{Binding PluginInfo.IssuesUrl}">
                                <ci:FluentIcon Glyph="&#xE809;" FontSize="18" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </controls:SettingsExpanderItem>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
