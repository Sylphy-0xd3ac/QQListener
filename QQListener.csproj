<Project>
    <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

    <PropertyGroup>
        <TargetFramework>$(QQListenerTargetFramework)</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDynamicLoading>True</EnableDynamicLoading>
        <Version>$(QQListenerReleaseVersion)</Version>
        <AssemblyVersion>$(QQListenerVersion)</AssemblyVersion>
        <FileVersion>$(QQListenerVersion)</FileVersion>
        <InformationalVersion>$(QQListenerReleaseVersion)</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Samples\**\*.cs;Tests\**\*.cs;Tools\**\*.cs;Bootstrap\**\*.cs" />
        <AvaloniaResource Remove="Samples\**\*;Tests\**\*;Tools\**\*" />
        <AvaloniaXaml Remove="Samples\**\*;Tests\**\*;Tools\**\*" />
        <Content Remove="Samples\**\*;Tests\**\*;Tools\**\*" />
        <EmbeddedResource Remove="Samples\**\*;Tests\**\*;Tools\**\*" />
        <None Remove="Samples\**\*;Tests\**\*;Tools\**\*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="Bootstrap/QQListener.Loader.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="CreateCipx">
            <AdditionalProperties Condition="'$(CreateCipx)' == 'true' and !$([MSBuild]::IsOSPlatform('Windows'))">QQListenerTargetFramework=$(TargetFramework);EnableWindowsTargeting=true</AdditionalProperties>
        </ProjectReference>
        <EmbeddedResource Include="Assets/Updates/runtime-public.pem" LogicalName="QQListener.Updates.public.pem" />
        <PackageReference Include="ClassIsland.PluginSdk" Version="$(ClassIslandPluginSdkVersion)">
            <ExcludeAssets>runtime; native</ExcludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Distribution/pmhq/9.0.6-local-pipe.2.json" LogicalName="QQListener.PMHQ.release.json" />
        <Content Include="Assets/Sounds/notify_sound.mp3"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="Assets/Sounds/important_sound.mp3"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <AvaloniaResource Include="icon.png" />
        <None Update="manifest.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="README.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="CHANGELOG.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="LICENSE;DEVELOPMENT.md;docs/usage.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Update="Assets/PMHQ/NOTICE.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Update="docs/reviews/**/*.md;docs/reviews/evidence/*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Update="icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="ValidateCipxTargetFramework" BeforeTargets="PrepareForBuild"
            Condition="'$(CreateCipx)' == 'true'">
        <Error Condition="'$(TargetFramework)' != 'net8.0-windows10.0.19041.0'"
               Text="CIPX packages must target net8.0-windows10.0.19041.0." />
    </Target>

    <Target Name="CopyPluginLoader" AfterTargets="Build" BeforeTargets="SyncLocalClassIslandDebugPlugin">
        <ItemGroup>
            <LoaderOutput Include="$(MSBuildProjectDirectory)/Bootstrap/bin/$(Configuration)/$(TargetFramework)/QQListener.Loader.dll;$(MSBuildProjectDirectory)/Bootstrap/bin/$(Configuration)/$(TargetFramework)/QQListener.Loader.deps.json" />
        </ItemGroup>
        <Copy SourceFiles="@(LoaderOutput)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="SyncLocalClassIslandDebugPlugin" AfterTargets="Build"
            Condition="'$(Configuration)' == 'Debug' and Exists('..\ClassIsland\ClassIsland.Desktop\bin\Debug\net8.0-windows10.0.19041.0')">
        <PropertyGroup>
            <LocalClassIslandPluginDir>..\ClassIsland\ClassIsland.Desktop\bin\Debug\net8.0-windows10.0.19041.0\Plugins\QQListener\</LocalClassIslandPluginDir>
        </PropertyGroup>
        <ItemGroup>
            <LocalPluginFiles Include="$(TargetDir)*.*" />
        </ItemGroup>
        <MakeDir Directories="$(LocalClassIslandPluginDir)" />
        <Copy SourceFiles="@(LocalPluginFiles)"
              DestinationFolder="$(LocalClassIslandPluginDir)"
              SkipUnchangedFiles="true"
              Retries="0"
              ContinueOnError="WarnAndContinue" />
        <Message Importance="high"
                 Text="Synced QQListener debug build to $(LocalClassIslandPluginDir)" />
    </Target>

    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

    <!-- Override the SDK packer after its targets have been imported. -->
    <Target Name="CreateCipx" AfterTargets="Build" DependsOnTargets="CopyPluginLoader" Condition="'$(CreateCipx)' == 'true'">
        <PropertyGroup>
            <PackageDotnetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</PackageDotnetHost>
            <PackageDotnetHost Condition="'$(PackageDotnetHost)' == ''">dotnet</PackageDotnetHost>
            <RuntimeBuildNumber Condition="'$(RuntimeBuildNumber)' == ''">0</RuntimeBuildNumber>
        </PropertyGroup>
        <Exec Command="&quot;$(PackageDotnetHost)&quot; run --project &quot;$(MSBuildProjectDirectory)/Tools/QQListener.PackageBuilder&quot; --configuration $(Configuration) -- &quot;$(MSBuildProjectDirectory)&quot; &quot;$(TargetDir).&quot; &quot;$(MSBuildProjectDirectory)/Bootstrap/bin/$(Configuration)/$(TargetFramework)&quot; &quot;$(QQListenerReleaseVersion)&quot; $(RuntimeBuildNumber)" />
    </Target>
</Project>
