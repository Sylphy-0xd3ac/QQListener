<Project>
  <PropertyGroup>
    <QQListenerVersion>2.1.0.0</QQListenerVersion>
    <ClassIslandPluginSdkVersion>2.1.0.1</ClassIslandPluginSdkVersion>
    <QQListenerTargetFramework Condition="'$(CreateCipx)' == 'true'">net8.0-windows10.0.19041.0</QQListenerTargetFramework>
    <EnableWindowsTargeting Condition="'$(CreateCipx)' == 'true'">true</EnableWindowsTargeting>
    <QQListenerTargetFramework Condition="'$(QQListenerTargetFramework)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">net8.0-windows10.0.19041.0</QQListenerTargetFramework>
    <QQListenerTargetFramework Condition="'$(QQListenerTargetFramework)' == ''">net8.0</QQListenerTargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.$(QQListenerTargetFramework).lock.json</NuGetLockFilePath>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
